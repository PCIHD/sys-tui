#!/usr/bin/env bash
# GPU-only root wrapper. Prefer ./systui-root for the combined TUI.
set -euo pipefail
ROOT="$(dirname "$(readlink -f "$0")")"
PY="$ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "gputui-root: $PY missing — run 'uv sync' in $ROOT first" >&2
  exit 1
fi
cd "$ROOT"
if [[ ${EUID} -eq 0 ]]; then
  exec "$PY" -m gputui "$@"
fi
exec sudo env \
  "TERM=${TERM:-xterm-256color}" \
  "COLORTERM=${COLORTERM-}" \
  "LANG=${LANG:-C.UTF-8}" \
  "$PY" -m gputui "$@"
